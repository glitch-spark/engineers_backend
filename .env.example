MONGODB_URI=REPLACE_ME
# At least 32 chars (the app refuses to boot otherwise): python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=REPLACE_ME

FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=America/New_York

JWT_EXPIRES_MIN=720

# Slack interview bot (docs/slack-interview-bot.md). Bot token scopes: chat:write, im:write.
# Users type their Slack member ID in Profile.
SLACK_BOT_TOKEN=
SLACK_BOT_CRON_SECRET=
# Channel (C…) for caller interviews: one thread per interview. Invite the bot to it first.
SLACK_CALLER_CHANNEL_ID=
# Release cutoff (America/Chicago, YYYY-MM-DDTHH:MM): the daily channel's after-interview checks and 7-day result reminders cover only rounds that end after it. Blank = all off.
SLACK_CALLER_ASKS_FROM=
# Channel (C…) for the daily list of caller interviews; blank = off. HH:MM in the timezone below.
SLACK_CALLER_DAILY_CHANNEL_ID=
SLACK_CALLER_DAILY_TIME=05:00
SLACK_CALLER_DAILY_TIMEZONE=America/Chicago
# Channel (C…) for daily plan posts. Invite the bot first; it edits or
# deletes its post when the plan changes in the app.
SLACK_DAILY_PLAN_CHANNEL_ID=
# Channel (C…) for transaction posts with Approve/Reject buttons. Invite the bot first; blank = off.
SLACK_TRANSACTIONS_CHANNEL_ID=
# Slack app → Basic Information → Signing Secret. Verifies button clicks; blank = no buttons.
SLACK_SIGNING_SECRET=

# In-app alerts tick (card renewals, weekly plan, daily bids) reuses
# SLACK_BOT_CRON_SECRET on POST /internal/alerts/tick.
# Railway sibling: `python -m app.alerts_tick` on */5 (Slack digest first, then inbox).
# Copy SLACK_BOT_TOKEN + FRONTEND_ORIGIN onto that service. Do not cron uvicorn.

# OpenAI
OPENAI_API_KEY=

# Models — split by task. Don't change unless you've benchmarked alternatives.
# - OPENAI_MODEL: streaming AI Review (interview detail page). Long-form, a budget model is enough.
# - RESUME_OPENAI_MODEL: OpenAI calls outside the model picker (interview answer scoring, analyze
#   rollup and chat, Job Applies job posting extraction unless JOB_EXTRACT_MODEL is set).
# - EXTRACTION_MODEL: cheap JSON-only tasks (Q&A extraction from transcripts).
# Don't use gpt-4o-mini: OpenAI retires it on 2027-01-14.
OPENAI_MODEL=gpt-6-luna
RESUME_OPENAI_MODEL=gpt-6-luna
EXTRACTION_MODEL=gpt-6-luna

# Resume storage (Backblaze B2 or AWS S3). Without a bucket the PDF is stored as base64
# inline in MongoDB (works, just bloats docs).
RESUME_STORAGE_BUCKET=
# Backblaze: https://s3.us-east-005.backblazeb2.com (the bucket's Endpoint). Blank = AWS S3.
RESUME_STORAGE_ENDPOINT_URL=
# Backblaze: optional, read from the endpoint (us-east-005). AWS: required, e.g. us-east-2.
RESUME_STORAGE_REGION=
# Backblaze: required, the application key ID (005...) and application key (K005...).
RESUME_STORAGE_ACCESS_KEY_ID=
RESUME_STORAGE_SECRET_ACCESS_KEY=

# AWS credentials: only the bidder storage fallback below uses these.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bidders — daily/weekly bid-count reports counted from each bidder's screenshot folder
# (AWS S3, or an S3-compatible store such as Backblaze B2).
BID_STORAGE_PROVIDER=s3
# AWS: optional; blank falls back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION.
# Backblaze: required, no AWS fallback. The application key ID (005...) and application key (K005...).
BID_STORAGE_ACCESS_KEY_ID=
BID_STORAGE_SECRET_ACCESS_KEY=
# Backblaze: optional, read from the endpoint (us-east-005).
BID_STORAGE_REGION=
# Blank = AWS S3. Backblaze: https://s3.us-east-005.backblazeb2.com
BID_STORAGE_ENDPOINT_URL=
# Bucket that bidder screenshot folders live in (new bidders get s3://<bucket>/<folder>/).
BID_STORAGE_BUCKET=bid-screenshots
BID_REPORT_TIMEZONE=America/Chicago
# HH:MM, 24h, in BID_REPORT_TIMEZONE.
BID_DAILY_REPORT_TIME=18:30
# monday ... sunday
BID_WEEKLY_REPORT_DAY=saturday
BID_WEEKLY_REPORT_TIME=16:00
# Optional schedule switch. Leave BID_SCHEDULE_SWITCH_AT unset (blank) to keep the schedule above forever.
# When set, reports follow the schedule above until that moment and the NEXT values take over at it.
# Format YYYY-MM-DDTHH:MM, local time in BID_REPORT_TIMEZONE.
# All three NEXT values are required with it, and the switch moment must be the NEXT weekly day at the NEXT
# weekly time, or the app refuses to start. The week ending at the switch is one long week
# (Sat 2026-11-14 16:00 -> Sun 2026-11-22 20:00, about 8 days).
# Deploy order: deploying this code first is safe, nothing changes until BID_SCHEDULE_SWITCH_AT is set.
# Deadline: BOTH Railway services, engineers_backend (API) and keen-spirit (report cron), must be RUNNING THIS
# CODE, not only have the variables set, before the last old weekly cutoff the switch removes (the Saturday
# cutoff before the switch). For the switch below that is Sat 2026-11-21 16:00 Chicago. Old code ignores the new
# variables, posts the Saturday weekly report, and the long week would then pay those days again. The
# double-report guard now refuses that long-week report (nothing saved or posted, an error logged naming both
# periods, status overlap:<period>) and stays blocked until someone intervenes. If that Saturday is missed, move
# BID_SCHEDULE_SWITCH_AT to a later Sunday instead; the deadline moves to the Saturday before it.
# Set all four on both services.
# Week-over-week change is skewed for the long week and the first Sunday week; this is a one-off.
# Values for the Sunday switch:
#   BID_SCHEDULE_SWITCH_AT=2026-11-22T20:00  BID_NEXT_DAILY_REPORT_TIME=18:00
#   BID_NEXT_WEEKLY_REPORT_DAY=sunday        BID_NEXT_WEEKLY_REPORT_TIME=20:00
BID_SCHEDULE_SWITCH_AT=
BID_NEXT_DAILY_REPORT_TIME=
BID_NEXT_WEEKLY_REPORT_DAY=
BID_NEXT_WEEKLY_REPORT_TIME=
# Optional short week (BID_SCHEDULE_SHORT_WEEK=true, default false): instead of the long week, the old Saturday
# weekly cutoffs run up to the switch and the slice from the last one to the switch is its own short pay week,
# reported and paid once. For a switch at 2026-11-15T20:00: Sat 11-14 16:00 -> Sun 11-15 20:00, one report day
# (Sun 11-15); the first Sunday week is then Mon 11-16 .. Sun 11-22. Set it on both services with the switch.
# (Not listed as a KEY= line here; it is read from the environment like the values above.)
# Bid reports count approved bid records (pending/rejected shown beside them). Optional cut-over day,
# YYYY-MM-DD in BID_REPORT_TIMEZONE: a window starting before that day's local midnight (or straddling it)
# keeps the old screenshot-folder count. Blank = bid records everywhere. Set it on the API and the cron.
BID_RECORDS_START=
# Unset = reports are saved but not posted.
SLACK_BIDS_CHANNEL_ID=

# Selectable Claude models for resume / cover letter / screening (app/model_catalog.py).
# Leave ANTHROPIC_API_KEY empty to hide the Anthropic models from the selector.
ANTHROPIC_API_KEY=
# Only for user-level keys (sk-ant-usr-...), which aren't tied to a workspace: wrkspc_... id.
# ANTHROPIC_WORKSPACE_ID=
# Defaults when a request doesn't pick a model (provider-prefixed ids).
# RESUME_DEFAULT_MODEL=anthropic:claude-sonnet-5-5
# COVER_LETTER_DEFAULT_MODEL=anthropic:claude-opus-5-5
# SCREENING_DEFAULT_MODEL=anthropic:claude-sonnet-5-5
# JUDGE_DEFAULT_MODEL=anthropic:claude-opus-5-5
# Longest resume prompt in characters (resume units, profile / user resume prompts, one-off prompts). The editor
# reads it from the API. Every character is also model input on each generation.
# RESUME_PROMPT_MAX_CHARS=30000
# Resumes generating at once across all users (default 10). Claims are round-robin per user, so one big batch no longer
# blocks others. Spend is per resume, not per slot; raise RESUME_RENDER_CONCURRENCY (Chromium, RAM-heavy) separately.
# RESUME_LLM_CONCURRENCY=10

# Resume prompt evaluator (Resumes → Prompt Eval): JDs scored at once per run.
# PROMPT_EVAL_CONCURRENCY=4
# Optional Redis cache for prompt-eval judge verdicts (not generated resumes), keyed by content
# hash + model. Blank = off. TTL defaults to 30 days.
REDIS_URL=
# LLM_CACHE_TTL_SECONDS=2592000
# YYYY-MM-DD: profile metrics ignore earlier weeks. Unset = the day after this release first started on the deployed
# backend (RESUME_QUEUE_ENABLED=1), recorded once in the database. 0001-01-01 = every completed week.
# PROFILE_METRICS_SINCE=2026-11-10
