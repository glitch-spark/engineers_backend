MONGODB_URI=REPLACE_ME
AUTH_SECRET=REPLACE_ME

FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=America/New_York

# Email integration — Gmail (Google OAuth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/gmail/oauth-callback

# Email integration — Outlook (Microsoft Identity)
# Tenant: "common" supports personal + work accounts. Pin to a tenant id
# once you've registered + verified an app in Azure AD.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/outlook/oauth-callback
MS_OAUTH_TENANT=common

# Fernet key for refresh-token-at-rest encryption.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_TOKEN_KEY=
JWT_EXPIRES_MIN=720

SLACK_WEBHOOK_URL=

# Slack interview bot (private daily digest DMs)
# Create an app at https://api.slack.com/apps — Bot Token + OAuth (user_scope=identity.basic)
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/slack/oauth-callback
SLACK_BOT_CRON_SECRET=
SLACK_DIGEST_HOUR=8
SLACK_DIGEST_MINUTE=0
# Private channel (C…) for "Caller needed" posts. Invite the bot to it first.
SLACK_CALLER_CHANNEL_ID=

# In-app alerts tick (card renewals, weekly plan, daily bids) reuses
# SLACK_BOT_CRON_SECRET on POST /internal/alerts/tick.
# Railway sibling: `python -m app.alerts_tick` on */5 (Slack digest first, then inbox).
# Copy SLACK_BOT_TOKEN + FRONTEND_ORIGIN onto that service. Do not cron uvicorn.

# OpenAI
OPENAI_API_KEY=

# Models — split by task. Don't change unless you've benchmarked alternatives.
# - OPENAI_MODEL: streaming AI Review (interview detail page). Long-form, mini is enough.
# - RESUME_OPENAI_MODEL: high-quality structured generation (resume HTML, screening answers,
#   interview answer scoring). Output ships to users; judgment matters.
# - EXTRACTION_MODEL: cheap JSON-only tasks (Q&A extraction from transcripts, tips rollup).
OPENAI_MODEL=gpt-4o-mini
RESUME_OPENAI_MODEL=gpt-5-mini
EXTRACTION_MODEL=gpt-4o-mini

# AWS S3 — required only if you want resume PDFs in S3. Without these,
# the PDF is stored as base64 inline in MongoDB (works, just bloats docs).
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
